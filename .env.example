# ============================================
# CONFIGURACIÓN DE ENTORNO - TallerPro (Docker)
# ============================================
# Copia este archivo a .env y ajusta los valores
# NO subas el archivo .env real al repositorio

# ============================================
# SEGURIDAD (CRÍTICO)
# ============================================
# Clave secreta para JWT - GENERA UNA NUEVA con:
# openssl rand -hex 32
SECRET_KEY=cambiar-esta-clave-secreta-en-produccion-usar-openssl-rand-hex-32

# ============================================
# FRONTEND
# ============================================
NODE_ENV=production
VITE_APP_NAME=TallerPro
VITE_APP_VERSION=1.0.0
# El frontend usa la ruta relativa /api/v1 (Vite y Nginx la redirigen al backend),
# así que normalmente no hace falta definirla.
VITE_API_URL=/api/v1

# ============================================
# BACKEND
# ============================================
DATABASE_URL=sqlite:///./data/taller.db
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost
# Zona horaria del taller (offset respecto a UTC). Colombia = -5
UTC_OFFSET_HOURS=-5

# ============================================
# PUERTOS
# ============================================
# Frontend (Nginx)
FRONTEND_PORT=8000
# Backend (FastAPI)
BACKEND_PORT=8001

# ============================================
# BACKUP
# ============================================
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
