# ============================================
# CONFIGURACIÓN DE ENTORNO - TallerPro
# ============================================
# Copia este archivo a .env y ajusta los valores
# NO subas el archivo .env real al repositorio

# ============================================
# ENTORNO
# ============================================
NODE_ENV=production
VITE_APP_NAME=TallerPro
VITE_APP_VERSION=1.0.0

# ============================================
# API (cuando se implemente backend real)
# ============================================
# URL del backend API
VITE_API_URL=http://localhost:8001/api/v1
# Timeout de peticiones en milisegundos
VITE_API_TIMEOUT=30000

# ============================================
# AUTENTICACIÓN (backend)
# ============================================
# Clave secreta para JWT (generar con: openssl rand -hex 32)
JWT_SECRET_KEY=cambiar-esto-por-una-clave-segura-en-produccion
# Duración del token en horas
JWT_EXPIRATION_HOURS=12

# ============================================
# BASE DE DATOS (backend)
# ============================================
# SQLite (desarrollo)
DATABASE_URL=sqlite:///./data/taller.db
# PostgreSQL (producción)
# DATABASE_URL=postgresql://user:password@localhost:5432/tallerdb

# ============================================
# ALMACENAMIENTO
# ============================================
# Ruta para archivos subidos (fotos)
UPLOAD_DIR=./uploads
# Tamaño máximo de archivo en MB
MAX_UPLOAD_SIZE_MB=5

# ============================================
# CORS (backend)
# ============================================
# Dominios permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://tudominio.com

# ============================================
# SEGURIDAD
# ============================================
# Rate limiting (peticiones por minuto)
RATE_LIMIT_PER_MINUTE=100
# Habilitar HTTPS redirect
FORCE_HTTPS=false

# ============================================
# LOGS
# ============================================
# Nivel de log: debug, info, warn, error
LOG_LEVEL=info
# Habilitar logs de base de datos
DB_LOGGING=false

# ============================================
# PWA
# ============================================
# Habilitar service worker
ENABLE_SW=true
# Versión del cache
CACHE_VERSION=v1

# ============================================
# BACKUP
# ============================================
# Ruta para backups
BACKUP_DIR=./backups
# Retención de backups en días
BACKUP_RETENTION_DAYS=30
# Hora de backup automático (formato 24h)
BACKUP_SCHEDULE_HOUR=2
